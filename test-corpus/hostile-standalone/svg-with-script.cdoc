<cdoc>
  <metadata>
    <title>SVG with script</title>
  </metadata>
  <svg xmlns="http://www.w3.org/2000/svg" width="300" height="200" onload="window.__pwned = true">
    <rect x="0" y="0" width="300" height="200" fill="#eee" />
    <script>window.__pwned = true;</script>
    <circle cx="150" cy="100" r="40" fill="#c33" onclick="window.__pwned = true" />
  </svg>
</cdoc>
